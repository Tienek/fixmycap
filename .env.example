# FixMyCar AI Environment Configuration Template
# Copy this file to .env and fill in your actual settings.
# NEVER commit your actual .env file to version control.

# Flask secret key for session signing and CSRF protection
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# PostgreSQL Database connection URL
# Format: postgresql://username:password@hostname:port/database_name
# For local SQLite fallback (if PostgreSQL is not installed locally): sqlite:///fixmycar.db
DATABASE_URL=postgresql://fixmycar_user:your_secure_password@localhost:5432/fixmycar_db

# Flask environment settings (0 for production, 1 for local development)
FLASK_DEBUG=0
PORT=5000
